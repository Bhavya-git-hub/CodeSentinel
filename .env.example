# Copy to .env and adjust. Every variable is prefixed CODESENTINEL_ so an unrelated
# tool's LOG_LEVEL on the same host cannot leak into this application's configuration.

# -- Application --------------------------------------------------------------------
CODESENTINEL_ENVIRONMENT=local
CODESENTINEL_LOG_LEVEL=INFO
CODESENTINEL_CORS_ORIGINS=http://localhost:5173

# -- Persistence --------------------------------------------------------------------
CODESENTINEL_DATABASE_URL=postgresql+asyncpg://codesentinel:codesentinel@localhost:5432/codesentinel

# Set this to run the tests marked `requires_db`. When it is unset those tests SKIP with
# an explicit reason -- they are never silently passed.
CODESENTINEL_TEST_DATABASE_URL=postgresql+asyncpg://codesentinel:codesentinel@localhost:5432/codesentinel_test

# -- Broker -------------------------------------------------------------------------
CODESENTINEL_REDIS_URL=redis://localhost:6379/0

# -- Sandbox (phase 2) --------------------------------------------------------------
# Resource bounds for the throwaway container each target repository is analysed in.
CODESENTINEL_SANDBOX_IMAGE=codesentinel/analysis:0.1.0
CODESENTINEL_SANDBOX_MEM_LIMIT=2g
CODESENTINEL_SANDBOX_TIMEOUT_SECONDS=600
CODESENTINEL_SANDBOX_PIDS_LIMIT=256

# -- Ingestion (phase 3) ------------------------------------------------------------
# Clones are full, never shallow: phase 4 churn and phase 8 SZZ both need complete
# history. A size guard takes the place of a depth limit.
CODESENTINEL_CLONE_ROOT=/var/lib/codesentinel/clones
CODESENTINEL_MAX_REPO_SIZE_MB=1024

# Transport allowlist for cloning. https only by default; an ext:: URL is arbitrary
# command execution on the host. Tests set this to `file` to clone from a local path.
CODESENTINEL_CLONE_ALLOWED_PROTOCOLS=https

# How often the size guard samples the growing clone. The guard is a ceiling with
# overshoot: the real bound is the limit plus (interval x transfer rate).
CODESENTINEL_CLONE_SIZE_CHECK_INTERVAL_SECONDS=0.5

# -- Analysis (phase 4) --------------------------------------------------------------
# Half-life for recency-weighted churn. A change this many days old counts half as much
# as the same change made today.
CODESENTINEL_CHURN_HALF_LIFE_DAYS=90

# Set false where no Docker daemon is available: scans still ingest, and record that
# analysis was skipped rather than reporting a repository with no findings.
CODESENTINEL_ANALYSIS_ENABLED=true

# -- Security (production) -----------------------------------------------------------
# Comma-separated caller secrets. Empty is fine locally; the API refuses to start when
# CODESENTINEL_ENVIRONMENT=production and this is empty, because an open instance clones
# and analyses whatever a caller names. See docs/adr/0016.
#
# A key may be written `name:secret`. The name is what the API logs for every request
# made with it, which is what turns "someone submitted 400 scans" into a sentence naming
# which consumer to talk to and which key to revoke. The whole string is still the
# secret, so a key with no colon keeps working unchanged.
#
#   CODESENTINEL_API_KEYS=ci-runner:xR3...,dashboard:9Kd...
CODESENTINEL_API_KEYS=

# Scan submissions per API key per minute. Fails closed if Redis is unreachable.
CODESENTINEL_SCAN_RATE_LIMIT_PER_MINUTE=10

# -- Retention -----------------------------------------------------------------------
# How long a terminal scan is kept, in days. 0 disables pruning entirely and is the
# default: scans accumulate without bound until you choose a window. Turning it on also
# deletes repositories left with no scans, which is what actually reclaims the space --
# files, commits and file_changes cascade from the repository, not from the scan.
CODESENTINEL_RETENTION_DAYS=0

# How often the pruning job runs when retention is on.
CODESENTINEL_RETENTION_INTERVAL_HOURS=24

# -- Observability -------------------------------------------------------------------
# Serves Prometheus exposition at /metrics. Unauthenticated when on -- a scraper cannot
# present a caller key -- so keep it on a private network. It carries only aggregates:
# no repository URL, no key, nothing naming who submitted what. See docs/adr/0018.
CODESENTINEL_METRICS_ENABLED=false
