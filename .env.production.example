# Production environment. Copy to .env, fill in real values, and keep it out of git.
#
# There are deliberately no working defaults for the three required values below. A
# default credential that works is a credential nobody changes, so compose refuses to
# start rather than falling back to the development password published in this repo.

# --- required -----------------------------------------------------------------------
# Database password. Generate, do not invent:  openssl rand -base64 32
POSTGRES_PASSWORD=

# Comma-separated caller secrets. The API refuses to boot in production with none,
# because this service clones and analyses whatever a caller names.
# Generate one per consumer so you can revoke them individually:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CODESENTINEL_API_KEYS=

# The origin your frontend is served from. Not a wildcard: the API is authenticated,
# and a wildcard origin plus a browser-held key is a credential any site can borrow.
CODESENTINEL_CORS_ORIGINS=https://codesentinel.example.com

# --- optional -----------------------------------------------------------------------
# Scan submissions allowed per API key per minute. A scan costs a clone, a history walk
# and several containers, so this is a capacity control, not a politeness one.
CODESENTINEL_SCAN_RATE_LIMIT_PER_MINUTE=10

# Largest repository accepted, in megabytes. The guard is a ceiling with overshoot:
# the real bound is this plus (sample interval x transfer rate).
CODESENTINEL_MAX_REPO_SIZE_MB=1024

# Wall-clock budget for one clone, and for one analysis container.
CODESENTINEL_CLONE_TIMEOUT_SECONDS=900
CODESENTINEL_SANDBOX_TIMEOUT_SECONDS=600

# Half-life for recency-weighted churn. Changing it changes every score, and it is
# recorded with each scan so old results stay interpretable.
CODESENTINEL_CHURN_HALF_LIFE_DAYS=90

# Set false on a host with no Docker daemon: scans still ingest and record that analysis
# was skipped, rather than reporting a repository with no findings.
CODESENTINEL_ANALYSIS_ENABLED=true
