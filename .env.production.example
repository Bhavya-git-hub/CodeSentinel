# Production environment. Copy to .env, fill in real values, and keep it out of git.
#
# There are deliberately no working defaults for the three required values below. A
# default credential that works is a credential nobody changes, so compose refuses to
# start rather than falling back to the development password published in this repo.

# --- required -----------------------------------------------------------------------
# Database password. Generate, do not invent:  openssl rand -base64 32
POSTGRES_PASSWORD=

# Comma-separated caller secrets. The API refuses to boot in production with none,
# because this service clones and analyses whatever a caller names.
# Generate one per consumer so you can revoke them individually:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Name each one -- `name:secret`. The name appears in every log line for a request made
# with that key, so an anomaly in the logs identifies which consumer to talk to and
# which key to pull. Without names, all you can tell is that one of your keys did it.
#
#   CODESENTINEL_API_KEYS=ci-runner:xR3...,dashboard:9Kd...
CODESENTINEL_API_KEYS=

# The origin your frontend is served from. Not a wildcard: the API is authenticated,
# and a wildcard origin plus a browser-held key is a credential any site can borrow.
CODESENTINEL_CORS_ORIGINS=https://codesentinel.example.com

# --- optional -----------------------------------------------------------------------
# Scan submissions allowed per API key per minute. A scan costs a clone, a history walk
# and several containers, so this is a capacity control, not a politeness one.
CODESENTINEL_SCAN_RATE_LIMIT_PER_MINUTE=10

# Largest repository accepted, in megabytes. The guard is a ceiling with overshoot:
# the real bound is this plus (sample interval x transfer rate).
CODESENTINEL_MAX_REPO_SIZE_MB=1024

# Wall-clock budget for one clone, and for one analysis container.
CODESENTINEL_CLONE_TIMEOUT_SECONDS=900
CODESENTINEL_SANDBOX_TIMEOUT_SECONDS=600

# Half-life for recency-weighted churn. Changing it changes every score, and it is
# recorded with each scan so old results stay interpretable.
CODESENTINEL_CHURN_HALF_LIFE_DAYS=90

# Set false on a host with no Docker daemon: scans still ingest and record that analysis
# was skipped, rather than reporting a repository with no findings.
CODESENTINEL_ANALYSIS_ENABLED=true

# --- retention ----------------------------------------------------------------------
# How long a terminal scan is kept, in days. 0 keeps everything forever, which is the
# default and which grows without bound: one scan of a large repository writes several
# thousand commit rows. Setting this schedules a daily pruning pass on the beat service.
#
# It also deletes repositories left with no scans. That is deliberate and it is what
# actually frees the disk -- commits, files and file changes cascade from the repository
# row rather than from the scan. A scan still in PENDING or RUNNING is never pruned
# however old it is: that is a stuck scan, not an expired one.
CODESENTINEL_RETENTION_DAYS=0
CODESENTINEL_RETENTION_INTERVAL_HOURS=24

# --- observability ------------------------------------------------------------------
# Prometheus exposition at /metrics. Unauthenticated when enabled, because a scraper has
# no key to present -- so scrape it from inside the compose network. The TLS overlay
# deliberately does not proxy it. It carries only aggregates. See docs/adr/0018.
CODESENTINEL_METRICS_ENABLED=false

# --- TLS (only with docker-compose.tls.yml) -----------------------------------------
# The hostname this is served on. It must already resolve to this machine: a certificate
# is proof of control over a name, and there is no way to prove control of one that does
# not point here.
CODESENTINEL_DOMAIN=codesentinel.example.com

# Where Let's Encrypt sends expiry warnings.
CODESENTINEL_ACME_EMAIL=ops@example.com

# Which ACME server issues the certificate. Leave unset for Let's Encrypt production.
#
# Use staging for a first deploy. Production allows five failed authorisations per
# hostname per hour; a DNS record that is not quite right burns all five in a couple of
# restarts, and the lockout arrives exactly when someone is trying to fix it. Staging
# certificates are untrusted -- browsers will warn -- which is the point: it proves the
# issuance path works without spending the budget that matters.
#
#   CODESENTINEL_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
